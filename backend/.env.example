# Copy to backend/.env. Never commit credentials.

# LLM for extraction + optional selection: openai | openai_compatible | anthropic
# Other providers: copy .env.openai-compatible.example or .env.anthropic.example.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=
# OpenAI fallback key; also used ONLY by optional OpenAI embeddings.
OPENAI_API_KEY=
# Empty selects the provider default. For compatible services include /v1.
LLM_BASE_URL=
# Empty selects responses (OpenAI), chat_completions (compatible), messages (Anthropic).
LLM_API=
LLM_JSON_MODE=json_schema
# Empty for models/providers that do not accept reasoning_effort.
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# Local BioLORD encoder. Must match the model used to build the index.
EMBEDDER_MODEL=FremyCompany/BioLORD-2023-M
# Native installs: cpu | cuda | mps. Docker uses CPU.
EMBEDDER_DEVICE=cpu
DEFAULT_EMBEDDER=biolord

# Optional OpenAI embedding backend (independent of the LLM settings above).
OPENAI_EMBED_MODEL=text-embedding-3-small

# Paths default to this project's backend/data/indexes; normally leave unset.
# INDEX_DIR=/absolute/path/to/biolord
# OPENAI_INDEX_PATH=/absolute/path/to/openai/faiss.index
# OPENAI_META_PATH=/absolute/path/to/openai/store.meta.sqlite

TOP_K=10
MAX_SPANS=40
MIN_CONFIDENCE=0.4
SELECT_WORKERS=8
