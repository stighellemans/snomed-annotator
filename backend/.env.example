# Copy to backend/.env and fill in. Read by both the server and indexing.build.
# (backend/.env is git-ignored — never commit your key.)

# --- OpenAI (required) -------------------------------------------------------
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_REASONING_EFFORT=low

# --- BioLORD local embedder --------------------------------------------------
# Query encoder; MUST match the model the BioLORD index was built with.
EMBEDDER_MODEL=FremyCompany/BioLORD-2023-M
# cpu | cuda | mps for a native install. The Docker image uses CPU.
EMBEDDER_DEVICE=cpu

# --- OpenAI embedding backend ------------------------------------------------
# MUST match the model the OpenAI index was built with.
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Index locations ---------------------------------------------------------
# Defaults point at the repo-local indexes that `python -m indexing.build` writes.
# Override only if you store the indices elsewhere (e.g. an Azure mounted volume).
# INDEX_DIR=data/indexes/biolord
# OPENAI_INDEX_PATH=data/indexes/openai/faiss.index
# OPENAI_META_PATH=data/indexes/openai/store.meta.sqlite

# Default embedder when a request doesn't specify one: biolord | openai
DEFAULT_EMBEDDER=biolord

# --- Retrieval / pipeline tuning ---------------------------------------------
TOP_K=10
MAX_SPANS=40
MIN_CONFIDENCE=0.4
SELECT_WORKERS=8
