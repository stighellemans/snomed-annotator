# OpenAI-compatible Chat Completions endpoint, e.g. a local Ollama server.
# Docker on this host uses host.docker.internal; native install uses 127.0.0.1.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=local
LLM_MODEL=your-installed-model
LLM_API=chat_completions
LLM_JSON_MODE=json_schema
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
DEFAULT_EMBEDDER=biolord
EMBEDDER_DEVICE=cpu
# No OpenAI key is required when using BioLORD and this LLM endpoint.
