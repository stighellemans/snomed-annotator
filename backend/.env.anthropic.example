# Native Anthropic Messages API, using forced tool input for structured output.
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=
LLM_MODEL=your-claude-model
LLM_API=messages
LLM_JSON_MODE=json_schema
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
DEFAULT_EMBEDDER=biolord
EMBEDDER_DEVICE=cpu
# ANTHROPIC_API_KEY is also accepted when LLM_API_KEY is empty.
# No OpenAI key is required when using BioLORD and this provider.
